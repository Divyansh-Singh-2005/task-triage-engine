# Copy to .env and fill in. .env is gitignored and must never be committed.

LOG_LEVEL=INFO
DATA_DIR=./data

# Leave blank to use SQLite at ./data/agent.db
DATABASE_URL=

# LLM layer.
#   heuristic  = offline keyword baseline, no key, no network
#   anthropic  = real model; falls back to heuristic if the key is blank
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5
LLM_MAX_TOKENS=1500
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
