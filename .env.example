# Copy to .env and fill in. .env is gitignored and must never be committed.

LOG_LEVEL=INFO
LOG_FILE=
DATA_DIR=./data

# Leave blank to use SQLite at ./data/agent.db
DATABASE_URL=

# Monitoring loop
POLL_INTERVAL_SECONDS=300

# Optional passphrase for the dashboard. Blank disables the prompt.
# This is a speed bump, not authentication - see ui/auth.py.
DASHBOARD_PASSPHRASE=

# LLM layer. One of: heuristic, anthropic, openai, ollama
#   heuristic = offline keyword baseline, no key, no network
#   anthropic / openai = hosted; fall back to heuristic if the key is blank
#   ollama = local model over HTTP, no key needed
LLM_PROVIDER=anthropic
LLM_MAX_TOKENS=1500

LLM_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=

OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
